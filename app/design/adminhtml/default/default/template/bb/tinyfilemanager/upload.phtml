<!-- TinyFileManager popup modal -->
<div id="tfm-modal-overlay">
    <div id="tfm-modal-header">
        <span><?php echo $this->__('Import File Manager &mdash; var/import'); ?></span>
        <button type="button" id="tfm-modal-close" onclick="tfmCloseModal()"><?php echo $this->__('&times; Close'); ?></button>
    </div>
    <iframe id="tfm-modal-frame" src="" allowfullscreen></iframe>
</div>

<script type="text/javascript">
    var tfmUrl = '<?php echo $managerUrl; ?>';
    var tfmModified = false; // true only if a write action happened inside TFM

    function tfmOpenModal() {
        var overlay = document.getElementById('tfm-modal-overlay');
        var frame   = document.getElementById('tfm-modal-frame');
        // Only load URL the first time (or on explicit reload)
        if (!frame.src || frame.src === window.location.href) {
            frame.src = tfmUrl;
        }
        overlay.className = 'tfm-open';
        document.body.style.overflow = 'hidden';
    }

    function tfmCloseModal() {
        document.getElementById('tfm-modal-overlay').className = '';
        document.body.style.overflow = '';
        if (tfmModified) {
            // Files were changed — save the profile and return to edit view
            tfmModified = false;
            tfmLoaded   = false;
            var form = document.getElementById('edit_form');
            if (form) {
                // Remove any previously appended continue input to avoid duplicates
                var existing = form.querySelector('input[name="continue"]');
                if (!existing) {
                    var inp = document.createElement('input');
                    inp.type = 'hidden'; inp.name = 'continue'; inp.value = '1';
                    form.appendChild(inp);
                }
                form.submit();
            }
        }
        // No modifications — just close the modal, stay on the page
    }

    // Detect write actions posted from inside the iframe (AJAX + form submits)
    window.addEventListener('message', function(e) {
        if (e.data && e.data.tfmModified) {
            tfmModified = true;
        }
    });

    // Close on backdrop click
    document.getElementById('tfm-modal-overlay').addEventListener('click', function(e) {
        if (e.target === this) { tfmCloseModal(); }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { tfmCloseModal(); }
    });
</script>
